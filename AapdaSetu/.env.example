GEMINI_API_KEY=your_api_key_here
DATABASE_URL=sqlite:///./aapdasetu.db
VECTOR_DB_PATH=data/vector_db
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Blockchain / Web3 — Ethereum Sepolia (leave blank to run in mock mode)
WEB3_PROVIDER_URI=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key
AAPDA_SETU_CONTRACT_ADDRESS=0xYourDeployedContractAddress
BACKEND_WALLET_PRIVATE_KEY=0xyour_backend_wallet_private_key
BLOCK_EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/

# Shardeum Blockchain (Phase 2 — leave blank to use Sepolia or mock mode)
SHARDEUM_RPC_URL=
SHARDEUM_PRIVATE_KEY=
SHARDEUM_CONTRACT_ADDRESS=
SHARDEUM_CHAIN_ID=0
SHARDEUM_EXPLORER_URL=

# Open-Meteo (Phase 3 — no API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# RWA Module (Phase 1)
RWA_DEFAULT_RADIUS_KM=25.0
